<?xml version="1.0" encoding="utf-8"?>
<!--
  Only two folders are shared, and only for the moment they are needed: the
  camera's pending capture, and a downloaded update APK handed to the system
  installer. Nothing else in the app's storage is reachable through this
  provider.
-->
<paths>
    <cache-path name="captures" path="captures/" />
    <cache-path name="updates" path="updates/" />
</paths>
