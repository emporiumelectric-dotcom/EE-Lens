<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <!--
      Used for: reaching the Catalogue Manager on the shop's own PC over local
      Wi-Fi (address typed by the owner, checked to be a private one, every
      request carries the pairing code shown on the PC); checking GitHub's
      public releases page for a newer version when the owner presses "Check
      for update"; and cloud catalogue sync against Electric Emporium's
      Supabase project (anon/publishable key only, gated by Row Level
      Security — see com.fanlens.prototype.supabase), so this phone and the
      PC tool read and write the same products. Nothing happens on app
      launch by itself — every network call here is the direct result of
      something the owner pressed. MediaPipe's telemetry uploader shares
      this permission but has nowhere to send anything the owner has not
      asked for.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Lets the owner install a downloaded update APK from inside the app,
      the same as opening one from Downloads. This never installs anything by
      itself — it only hands a file to Android's own installer screen, which
      always requires the owner's explicit tap to proceed.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_electric_emporium"
        android:label="EE Lens"
        android:roundIcon="@drawable/ic_electric_emporium_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FanLens">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands the camera app a single file to write into. Not exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
